{
  "name": "@sumup/agent-toolkit-codegen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generates SumUp Agent Toolkit helpers from the OpenAPI schema.",
  "scripts": {
    "generate": "tsx src/index.ts ../../apis/specs/openapi.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "change-case": "^5.4.4",
    "commander": "^15.0.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.9.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
