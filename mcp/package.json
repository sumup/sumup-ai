{
  "name": "@sumup/mcp",
  "version": "0.12.1",
  "type": "module",
  "description": "MCP server for interacting with SumUp",
  "homepage": "https://github.com/sumup/sumup-ai",
  "license": "Apache-2.0",
  "author": "SumUp <support@sumup.com> (https://sumup.com/)",
  "mcpName": "io.github.sumup/mcp",
  "main": "dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "bin": {
    "mcp": "dist/index.mjs"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumup/sumup-ai.git"
  },
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.mjs",
    "build": "rslib build",
    "build:watch": "rslib build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "bugs": {
    "url": "https://github.com/sumup/sumup-ai/issues"
  },
  "keywords": [
    "sumup",
    "payments",
    "mcp",
    "mcp-server",
    "modelcontextprotocol"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "@sumup/agent-toolkit": "^0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@rslib/core": "^0.23.0",
    "@types/node": "^26.0.0",
    "rsbuild-plugin-publint": "^1.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
